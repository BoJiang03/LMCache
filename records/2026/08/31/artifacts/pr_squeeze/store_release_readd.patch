+class StoreReleasePlacement(Enum):
+    """Where a completed store batch's blocks re-enter vLLM's free queue.
+
+    vLLM allocates from the head, so the position decides how long the
+    just-stored prefix keeps its GPU-side prefix-cache entry.
+
+    Attributes:
+        EVICTION_HEAD: Requeue at the head, making the blocks the next
+            allocation victims. Their content has a copy below the GPU, so
+            spending them first spares blocks that do not. Pays only when the
+            working set is far larger than the pool.
+        LRU_TAIL: Requeue at the tail, vLLM's own placement for a freed cached
+            block (the default). In a multi-turn workload the just-stored
+            prefix is what the session's next turn asks for.
+    """
+
+    EVICTION_HEAD = "eviction_head"
+    LRU_TAIL = "lru_tail"
+
+
+def _accepts_prepend(pool_cls: "type[BlockPool]") -> bool:
+    """Whether ``pool_cls.free_blocks`` accepts the ``prepend`` parameter.
+
+    Releases without the parameter place freed blocks themselves (cached
+    ones at the tail), so a configured ``eviction_head`` placement falls
+    back to the tail there -- an eviction-quality degradation, not a
+    correctness one.
+
+    Args:
+        pool_cls: The concrete block-pool class in use.
+
+    Returns:
+        True when ``prepend`` can be passed.
+    """
+    try:
+        supported = "prepend" in inspect.signature(pool_cls.free_blocks).parameters
+    except (TypeError, ValueError):  # pragma: no cover - defensive
+        supported = False
+    if not supported:
+        logger.info(
+            "%s.free_blocks has no 'prepend' parameter; completed-store "
+            "blocks will requeue at the free-queue tail instead of the "
+            "eviction head",
+            pool_cls.__name__,
+        )
+    return supported
+
+
